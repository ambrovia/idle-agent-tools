{
  "name": "idle-agent-tools",
  "version": "0.9.1",
  "description": "Idle agent tools: a shared record of work for coding agents (idle-tasks) and a multi-agent development workflow on top of it (idle-skills).",
  "type": "module",
  "main": "./idle-skills/.opencode/plugins/pipeline.js",
  "exports": {
    ".": "./idle-skills/.opencode/plugins/pipeline.js"
  },
  "files": [
    "idle-skills/",
    "!idle-skills/**/node_modules/**",
    "!idle-skills/**/.annotations/**",
    "!idle-skills/**/.vite/**",
    "idle-tasks/",
    "!idle-tasks/node_modules/**",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check:opencode-plugin": "node --check idle-skills/.opencode/plugins/pipeline.js",
    "check:codex-installer": "bash -n scripts/install-codex.sh",
    "check:installers": "bash -n scripts/install-codex.sh scripts/install-cursor.sh scripts/install-opencode.sh scripts/install-antigravity.sh",
    "verify": "npm run check:opencode-plugin && npm run check:installers && npm run check:agents && npm test",
    "check:agents": "node scripts/generate-agents.mjs --check"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agent-skills",
    "multi-agent",
    "pipeline",
    "tdd",
    "review"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/ambrovia/idle-agent-tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ambrovia/idle-agent-tools.git"
  }
}
